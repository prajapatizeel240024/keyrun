# Copy to .env and adjust. Everything binds to 127.0.0.1.
KEYRUN_DATABASE_URL=postgres://keyrun:keyrun@127.0.0.1:5432/keyrun
KEYRUN_MOCKS_DATABASE_URL=postgres://keyrun:keyrun@127.0.0.1:5432/keyrun_mocks
KEYRUN_TEST_DATABASE_URL=postgres://keyrun:keyrun@127.0.0.1:5432/keyrun_test

# Control plane (server + dashboard + workflow editor)
KEYRUN_SERVER_PORT=4000
KEYRUN_ADMIN_TOKEN=dev-admin-token

# Mock apps
KEYRUN_HR_PORT=4101
KEYRUN_HELPDESK_PORT=4102
KEYRUN_DIRECTORY_PORT=4103

# Local agent
KEYRUN_SERVER_URL=http://127.0.0.1:4000
KEYRUN_AGENT_HOME=.keyrun-agent
