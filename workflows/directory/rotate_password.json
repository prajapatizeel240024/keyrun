{
  "id": "directory.rotate_password",
  "app": "directory",
  "kind": "rotate_password",
  "version": 1,
  "description": "Change the admin account's own password in Mock Directory. The new password is generated on the device.",
  "params": {},
  "secrets": ["username", "password", "totpSecret", "newPassword"],
  "login": [
    { "op": "navigate", "url": "{{baseUrl}}/login" },
    {
      "op": "fill",
      "target": { "frame": "iframe[title='Sign in to Directory']", "label": "Username", "testId": "login-username" },
      "value": "{{secrets.username}}"
    },
    {
      "op": "fill",
      "target": { "frame": "iframe[title='Sign in to Directory']", "label": "Password", "testId": "login-password" },
      "value": "{{secrets.password}}"
    },
    {
      "op": "click",
      "target": { "frame": "iframe[title='Sign in to Directory']", "role": { "role": "button", "name": "Next" }, "testId": "login-next" }
    },
    {
      "op": "fill",
      "target": { "frame": "iframe[title='Sign in to Directory']", "label": "Digit 1", "exact": true, "css": "input[data-otp='1']" },
      "value": "{{totp}}",
      "mode": "type"
    },
    {
      "op": "click",
      "target": { "frame": "iframe[title='Sign in to Directory']", "role": { "role": "button", "name": "Verify" }, "testId": "otp-submit" }
    },
    { "op": "wait", "target": { "role": { "role": "link", "name": "Members" }, "testId": "nav-members" } }
  ],
  "steps": [
    { "op": "navigate", "url": "{{baseUrl}}/account/password", "checkpoint": true },
    { "op": "fill", "target": { "label": "Current password", "exact": true, "testId": "pw-current" }, "value": "{{secrets.password}}" },
    { "op": "fill", "target": { "label": "New password", "exact": true, "testId": "pw-new" }, "value": "{{secrets.newPassword}}" },
    { "op": "fill", "target": { "label": "Repeat new password", "exact": true, "testId": "pw-confirm" }, "value": "{{secrets.newPassword}}" },
    { "op": "click", "target": { "role": { "role": "button", "name": "Save password" }, "testId": "pw-save" }, "effect": true },
    { "op": "assert", "target": { "role": { "role": "status" } }, "text": "Password changed" }
  ]
}
