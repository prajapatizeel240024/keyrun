{
  "id": "directory.remove_user",
  "app": "directory",
  "kind": "remove_user",
  "version": 1,
  "description": "Delete a member from Mock Directory, only if present. The confirm dialog wants the email typed back.",
  "params": {
    "email": { "description": "Email of the member to delete", "example": "wen.okafor@example.test" }
  },
  "secrets": ["username", "password", "totpSecret"],
  "login": [
    { "op": "navigate", "url": "{{baseUrl}}/login" },
    {
      "op": "fill",
      "target": { "frame": "iframe[title='Sign in to Directory']", "label": "Username", "testId": "login-username" },
      "value": "{{secrets.username}}"
    },
    {
      "op": "fill",
      "target": { "frame": "iframe[title='Sign in to Directory']", "label": "Password", "testId": "login-password" },
      "value": "{{secrets.password}}"
    },
    {
      "op": "click",
      "target": { "frame": "iframe[title='Sign in to Directory']", "role": { "role": "button", "name": "Next" }, "testId": "login-next" }
    },
    {
      "op": "fill",
      "target": { "frame": "iframe[title='Sign in to Directory']", "label": "Digit 1", "exact": true, "css": "input[data-otp='1']" },
      "value": "{{totp}}",
      "mode": "type"
    },
    {
      "op": "click",
      "target": { "frame": "iframe[title='Sign in to Directory']", "role": { "role": "button", "name": "Verify" }, "testId": "otp-submit" }
    },
    { "op": "wait", "target": { "role": { "role": "link", "name": "Members" }, "testId": "nav-members" } }
  ],
  "steps": [
    { "op": "navigate", "url": "{{baseUrl}}/members", "checkpoint": true },
    { "op": "fill", "target": { "role": { "role": "searchbox", "name": "Search members" }, "testId": "member-search" }, "value": "{{params.email}}" },
    { "op": "press", "target": { "role": { "role": "searchbox", "name": "Search members" }, "testId": "member-search" }, "key": "Enter" },
    { "op": "wait", "url": "q=" },
    {
      "op": "findInPages",
      "row": { "testId": "member-row", "css": "tbody tr" },
      "match": "{{params.email}}",
      "ready": { "text": "· page", "css": "p" },
      "next": { "role": { "role": "link", "name": "Next" }, "testId": "next-page" },
      "saveAs": "exists"
    },
    {
      "op": "if",
      "var": "exists",
      "equals": "false",
      "then": [{ "op": "end", "outcome": "noop", "message": "{{params.email}} is not a member" }]
    },
    {
      "op": "click",
      "target": {
        "role": { "role": "button", "name": "Delete {{params.email}}", "exact": true },
        "testId": "delete-member",
        "within": { "testId": "member-row", "css": "tbody tr", "hasExactText": "{{params.email}}" }
      }
    },
    {
      "op": "fill",
      "target": { "role": { "role": "textbox", "name": "Type the email to confirm" }, "testId": "confirm-input" },
      "value": "{{params.email}}"
    },
    { "op": "click", "target": { "role": { "role": "button", "name": "Delete member" }, "testId": "confirm-delete" }, "effect": true },
    { "op": "assert", "target": { "role": { "role": "status" } }, "text": "deleted" }
  ]
}
