{
  "id": "hr.rotate_password",
  "app": "hr",
  "kind": "rotate_password",
  "version": 1,
  "description": "Change the admin account's own password in Mock HR. The new password is generated on the device; the app signs you out afterwards.",
  "params": {},
  "secrets": ["username", "password", "newPassword"],
  "login": [
    { "op": "navigate", "url": "{{baseUrl}}/login" },
    {
      "op": "fill",
      "target": { "frame": "iframe[title='Sign in']", "label": "Work email", "css": "input[type=email]" },
      "value": "{{secrets.username}}"
    },
    {
      "op": "fill",
      "target": { "frame": "iframe[title='Sign in']", "label": "Password", "css": "input[type=password]" },
      "value": "{{secrets.password}}"
    },
    {
      "op": "click",
      "target": { "frame": "iframe[title='Sign in']", "role": { "role": "button", "name": "Sign in" }, "css": "button[type=submit]" }
    },
    { "op": "wait", "target": { "role": { "role": "navigation", "name": "Main" }, "css": "nav" } }
  ],
  "steps": [
    { "op": "navigate", "url": "{{baseUrl}}/settings/password", "checkpoint": true },
    { "op": "fill", "target": { "label": "Current password", "exact": true }, "value": "{{secrets.password}}" },
    { "op": "fill", "target": { "label": "New password", "exact": true }, "value": "{{secrets.newPassword}}" },
    { "op": "fill", "target": { "label": "Confirm new password", "exact": true }, "value": "{{secrets.newPassword}}" },
    { "op": "click", "target": { "role": { "role": "button", "name": "Update password" }, "css": "main form button[type=submit]" }, "effect": true },
    { "op": "assert", "target": { "role": { "role": "status" } }, "text": "Password updated" }
  ]
}
