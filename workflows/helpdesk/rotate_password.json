{
  "id": "helpdesk.rotate_password",
  "app": "helpdesk",
  "kind": "rotate_password",
  "version": 1,
  "description": "Change the admin account's own password in Mock Helpdesk. The new password is generated on the device.",
  "params": {},
  "secrets": ["username", "password", "totpSecret", "newPassword"],
  "login": [
    { "op": "navigate", "url": "{{baseUrl}}/#/login" },
    {
      "op": "fill",
      "target": { "label": "Email", "placeholder": "you@company.com", "css": "input[type=email]" },
      "value": "{{secrets.username}}"
    },
    {
      "op": "fill",
      "target": { "label": "Password", "placeholder": "Password", "css": "input[type=password]" },
      "value": "{{secrets.password}}"
    },
    { "op": "click", "target": { "role": { "role": "button", "name": "Continue" } } },
    {
      "op": "fill",
      "target": { "role": { "role": "textbox", "name": "Authentication code" }, "css": "input[autocomplete=one-time-code]" },
      "value": "{{totp}}"
    },
    { "op": "click", "target": { "role": { "role": "button", "name": "Verify" } } },
    { "op": "wait", "target": { "role": { "role": "navigation", "name": "Sidebar" } } }
  ],
  "steps": [
    { "op": "navigate", "url": "{{baseUrl}}/#/settings/password", "checkpoint": true },
    { "op": "fill", "target": { "label": "Current password", "exact": true }, "value": "{{secrets.password}}" },
    { "op": "fill", "target": { "label": "New password", "exact": true }, "value": "{{secrets.newPassword}}" },
    { "op": "fill", "target": { "label": "Confirm password", "exact": true }, "value": "{{secrets.newPassword}}" },
    { "op": "click", "target": { "role": { "role": "button", "name": "Change password" }, "css": "main button" }, "effect": true },
    { "op": "assert", "target": { "role": { "role": "status" } }, "text": "Your password has been changed" }
  ]
}
