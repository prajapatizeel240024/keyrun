{
  "manifest_version": 3,
  "name": "Keyrun Recorder",
  "version": "0.1.0",
  "description": "Record clicks and typing on local admin portals and send them to the Keyrun workflow editor. Secrets are never recorded.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Keyrun Recorder", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js", "recorder.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
